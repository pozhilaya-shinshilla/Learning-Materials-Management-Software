# Скопируйте в .env и подставьте свои значения. .env в git не попадает.
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=Admin123!

# PostgreSQL 15+, драйвер psycopg 3. Если не задано, используется значение ниже
# (оно совпадает с docker-compose.yaml). Короткая форма postgresql:// тоже принимается.
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms
# База для тестов (необязательно; по умолчанию lms_test из docker-compose.yaml).
# Тесты пересоздают схему через Alembic и очищают таблицы: не указывайте рабочую базу!
TEST_DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms_test

# --- Запуск сервера (необязательно; значения по умолчанию указаны справа) ---
# APP_HOST=127.0.0.1        # в контейнере docker-compose.yaml ставит 0.0.0.0
# APP_PORT=8000
# DB_WAIT_SECONDS=30        # сколько ждать запуска БД при старте
# AUTO_MIGRATE=1            # 0: не применять миграции при старте (alembic upgrade head вручную)
# APP_TIMEZONE=Europe/Volgograd   # в этом поясе понимаются даты фильтра «загружен с … по …»

# --- Почта (необязательно; без SMTP_HOST письма печатаются в консоль) ---
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=noreply@example.org
# SMTP_USER=
# SMTP_PASSWORD=
